# Python caches and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local virtual environments (recreate from requirements.txt)
chiru/
.venv/
venv/
env/

# Generated packaging output
build/
dist/
installer_output/
*.spec.bak

# Standalone app-plugin development/build output (installed manually in NakshaAI)
/plugin_build/
/plugins/
# Plugin install packages and local plugin test bundles (never commit)
/naksha_basemap-*.zip
/naksha_file_ribbon_tests*
# Proprietary local converter payload; install it before building the app.
/snt_v2-1.0.2-cp310-cp310-win_amd64.whl

# Local point-cloud test/customer data and automatic backups
TESTIGN _FILES/
**/backup/
*.laz
*.las
*.snt
*.dwg
*.dxf

# Generated artifacts from the Phase 1 builder verification harness
# (regenerate with: python audit/naksha_phase1_verify.py)
audit/_nkverify_out/

# C++ .lnt converter: compiled binary and generated test containers
# (rebuild with: cd native/lnt && g++ -O3 -std=c++17 main.cpp -o main)
# any executable the converter or its preflight/benchmark tools produce
native/lnt/main
native/lnt/*.exe
native/lnt/*.dll
!native/lnt/main_display_modes_zoom.dll
!native/lnt/main_display_modes_lighting.dll
native/lnt/*.lnt*
native/lnt/*.o
native/lnt/*.obj

# Local archives and transient patches
NAKSHA-LIDAR.zip
NAKSHA-LIDAR.rar
*.log
*.tmp
*.zip

# Credentials and machine-local configuration
crash_config.json
.env
.env.*
!.env.example
*.key
*.pem

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
cloth_nodes.txt
.claude/
.cwj_uploads/
tests/
patch_backups/
.commandcode/
.workbuddy-ai/

# --- Local session artifacts (not part of the project source) ---
/diagnostics/
/scratch/
/logs/
/.freebuff/
/*.err
/*.txt
/*.png
/*.jsonl
/null
vulkan_*_output/
*.shards/
*.naksha*
# Local native continuity build output
/native/naksha_vulkan/build_continuity/

/native/naksha_vulkan/build_msvc/before_continuity/

# Per-source native point-cache provenance and selection indexes
*.lnt.source.json
*.lnt.lines
*.lnt.class-semantics
*.lntset
naksha_native_batches/

# ============================================================
# Vulkan build output
# Ignore everything except runtime artifacts required by Naksha
# ============================================================

native/naksha_vulkan/build_msvc/*

# Keep runtime DLL and build stamp
!native/naksha_vulkan/build_msvc/naksha_vulkan.dll
!native/naksha_vulkan/build_msvc/native_build_stamp.json

# Keep root compiled point shaders
!native/naksha_vulkan/build_msvc/*.spv
!native/naksha_vulkan/build_msvc/point.vert.spv
!native/naksha_vulkan/build_msvc/point.frag.spv

# Allow shaders directory so selected SPV files can be tracked
!native/naksha_vulkan/build_msvc/shaders/
native/naksha_vulkan/build_msvc/shaders/*

# Keep compiled shaders only
!native/naksha_vulkan/build_msvc/shaders/*.spv
