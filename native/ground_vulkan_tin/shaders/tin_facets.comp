#version 450
#extension GL_ARB_gpu_shader_fp64 : require

// GPU assembles terrain facet geometry from *already chosen* Delaunay
// triangle vertex coordinates. CPU SciPy still decides triangulation topology.
// Every result is bit-checked against the original NumPy formula in Python.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Vertices {
    double vertex_xyz[];
} triangles;
layout(set = 0, binding = 1, std430) writeonly buffer Facets {
    double normals_edges[];
} facets;
layout(push_constant) uniform Params {
    uint count;
} pc;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.count) return;
    uint i = id * 9u;
    dvec3 a = dvec3(triangles.vertex_xyz[i], triangles.vertex_xyz[i+1u], triangles.vertex_xyz[i+2u]);
    dvec3 b = dvec3(triangles.vertex_xyz[i+3u], triangles.vertex_xyz[i+4u], triangles.vertex_xyz[i+5u]);
    dvec3 c = dvec3(triangles.vertex_xyz[i+6u], triangles.vertex_xyz[i+7u], triangles.vertex_xyz[i+8u]);
    dvec3 ab = b - a;
    dvec3 bc = c - b;
    dvec3 ca = a - c;
    dvec3 n = cross(ab, c-a);
    double length_n = length(n);
    if (length_n > 0.0) n /= length_n;
    if (n.z < 0.0) n = -n;
    double maxedge = max(length(ab), max(length(bc), length(ca)));
    uint j = id * 5u;
    facets.normals_edges[j] = n.x;
    facets.normals_edges[j+1u] = n.y;
    facets.normals_edges[j+2u] = n.z;
    facets.normals_edges[j+3u] = maxedge;
    facets.normals_edges[j+4u] = length_n;
}
